  "type": "module",
  "description": "Reels verticales de Educaplay Secundaria (1080×1920, 25 fps) armados en After Effects",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "nuevo": "node --experimental-strip-types --no-warnings scripts/nuevo.mjs",
